<?xml version="1.0"?>
<package format="3">
  <name>rover_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and parameters: ros2_control, EKF, SLAM Toolbox, Nav2.</description>
  <maintainer email="dhruvjit26@gmail.com">Dhruv Trivedi</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_hardware</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <!-- micro_ros_agent has no rosdep key or Lyrical binary package: build it from source or run it in
       Docker, then set start_agent:=false if it runs outside this launch. See docs/microros.md. -->
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
