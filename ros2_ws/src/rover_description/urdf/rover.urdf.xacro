<?xml version="1.0"?>
<!-- Two-wheeled rover. Pass sim:=true for the Gazebo variant. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">
  <xacro:arg name="sim" default="false"/>
  <xacro:arg name="controllers_file" default=""/>

  <!-- Dimensions in metres; keep in sync with firmware/app/src/control.c -->
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="track" value="0.160"/>
  <xacro:property name="body_x" value="0.220"/>
  <xacro:property name="body_y" value="0.130"/>
  <xacro:property name="body_z" value="0.060"/>
  <xacro:property name="body_mass" value="1.2"/>
  <xacro:property name="wheel_mass" value="0.06"/>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"
                 iyy="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"
                 izz="${wheel_mass*wheel_radius*wheel_radius/2}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.02 0 0.01"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.7 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.02 0 0.01"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.02 0 0.01"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_mass*(body_y*body_y+body_z*body_z)/12}"
               iyy="${body_mass*(body_x*body_x+body_z*body_z)/12}"
               izz="${body_mass*(body_x*body_x+body_y*body_y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <xacro:wheel name="left" y="${track/2}"/>
  <xacro:wheel name="right" y="${-track/2}"/>

  <!-- Frictionless front caster -->
  <link name="caster">
    <visual><geometry><sphere radius="${wheel_radius*0.5}"/></geometry></visual>
    <collision><geometry><sphere radius="${wheel_radius*0.5}"/></geometry></collision>
    <inertial><mass value="0.02"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="0.085 0 ${-wheel_radius*0.5}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.04 0 0.045"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="red"><color rgba="0.7 0.1 0.1 1"/></material>
    </visual>
    <inertial><mass value="0.1"/>
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0.07"/>
  </joint>

  <xacro:macro name="wheel_if" params="name">
    <joint name="${name}_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-30</param>
        <param name="max">30</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="rover_system" type="system">
    <hardware>
      <xacro:if value="$(arg sim)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg sim)">
        <plugin>rover_hardware/RoverSystem</plugin>
        <param name="state_timeout">0.5</param>
      </xacro:unless>
    </hardware>
    <xacro:wheel_if name="left"/>
    <xacro:wheel_if name="right"/>
  </ros2_control>

  <xacro:if value="$(arg sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
    <gazebo reference="caster">
      <collision><surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
    </gazebo>
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </gazebo>
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
