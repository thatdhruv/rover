# NUCLEO-F429ZI under Renode: MCUboot + signed rover app.
# Set before including: $mcuboot=@.../mcuboot/zephyr/zephyr.hex  $app=@.../app/zephyr/zephyr.signed.confirmed.hex  $platform=@.../rover_platform.repl
using sysbus
$name?="rover"
mach create $name

machine LoadPlatformDescription $platform

sysbus LoadHEX $mcuboot
sysbus LoadHEX $app
showAnalyzer sysbus.usart3

# On real hardware flash is aliased at 0x0 for boot; Renode's model is not. Point the vector table
# at flash and load MCUboot's initial SP and PC by hand.
cpu VectorTableOffset 0x08000000
cpu SP `sysbus ReadDoubleWord 0x08000000`
cpu PC `sysbus ReadDoubleWord 0x08000004`
