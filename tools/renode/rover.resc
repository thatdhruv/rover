# NUCLEO-F429ZI under Renode: MCUboot + signed rover app.
# Set before including:  $mcuboot=@.../mcuboot/zephyr/zephyr.hex  $app=@.../app/zephyr/zephyr.signed.hex
using sysbus
$name?="rover"
mach create $name

machine LoadPlatformDescription @platforms/cpus/stm32f429.repl

sysbus LoadHEX $mcuboot
sysbus LoadHEX $app
showAnalyzer sysbus.usart3
